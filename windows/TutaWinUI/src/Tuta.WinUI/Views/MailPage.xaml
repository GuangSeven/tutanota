<Page
    x:Class="Tuta.WinUI.Views.MailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:domain="using:Tuta.Core.Domain"
    mc:Ignorable="d">
    <Grid ColumnDefinitions="360,*" Padding="16" RowDefinitions="Auto,*">
        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Inbox" FontSize="22" FontWeight="SemiBold" />
            <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
        </StackPanel>

        <ListView
            Grid.Row="1"
            Grid.Column="0"
            ItemsSource="{x:Bind ViewModel.Messages}"
            SelectedItem="{x:Bind ViewModel.SelectedMessage, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="domain:MailSummary">
                    <StackPanel Padding="8" Spacing="4">
                        <TextBlock Text="{x:Bind Subject}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind From}" Foreground="Gray" FontSize="12" />
                        <TextBlock Text="{x:Bind Preview}" Foreground="Gray" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="1" Grid.Column="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind ViewModel.SelectedSubject, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind ViewModel.SelectedFrom, Mode=OneWay}" Foreground="Gray" />
                <TextBlock Text="{x:Bind ViewModel.SelectedBody, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
