<Page
    x:Class="Tuta.WinUI.Views.ComposePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="12" Width="640">
            <TextBlock Text="Compose" FontSize="22" FontWeight="SemiBold" />
            <TextBox Header="To" Text="{x:Bind ViewModel.To, Mode=TwoWay}" PlaceholderText="user@tuta.example" />
            <TextBox Header="Subject" Text="{x:Bind ViewModel.Subject, Mode=TwoWay}" />
            <TextBox
                Header="Body"
                Text="{x:Bind ViewModel.Body, Mode=TwoWay}"
                AcceptsReturn="True"
                Height="220"
                TextWrapping="Wrap" />
            <ToggleSwitch Header="Confidential" IsOn="{x:Bind ViewModel.IsConfidential, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save Draft" Command="{x:Bind ViewModel.SaveDraftCommand}" />
                <Button Content="Send" Command="{x:Bind ViewModel.SendCommand}" />
                <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="Gray" />
        </StackPanel>
    </ScrollViewer>
</Page>
