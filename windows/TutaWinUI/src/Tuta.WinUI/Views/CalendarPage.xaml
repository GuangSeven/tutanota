<Page
    x:Class="Tuta.WinUI.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:domain="using:Tuta.Core.Domain"
    mc:Ignorable="d">
    <Grid Padding="24" ColumnDefinitions="360,*">
        <CalendarView
            x:Name="Calendar"
            SelectionMode="Single"
            SelectedDatesChanged="OnSelectedDatesChanged" />

        <StackPanel Grid.Column="1" Spacing="12">
            <TextBlock Text="Schedule" FontSize="20" FontWeight="SemiBold" />
            <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <ListView ItemsSource="{x:Bind ViewModel.Events}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="domain:CalendarEvent">
                        <StackPanel Padding="8" Spacing="4">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Start}" Foreground="Gray" />
                            <TextBlock Text="{x:Bind Location}" Foreground="Gray" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
