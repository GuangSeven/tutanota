<Page
    x:Class="Tuta.WinUI.Views.ContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:domain="using:Tuta.Core.Domain"
    mc:Ignorable="d">
    <Grid Padding="24" RowDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Width="320" PlaceholderText="Search" Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}" />
            <Button Content="Search" Command="{x:Bind ViewModel.SearchCommand}" />
            <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>

        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Contacts}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="domain:Contact">
                    <StackPanel Padding="8" Spacing="4">
                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind EmailAddresses[0], Mode=OneWay}" Foreground="Gray" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
