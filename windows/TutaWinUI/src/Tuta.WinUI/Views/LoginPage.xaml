<Page
    x:Class="Tuta.WinUI.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Tuta.WinUI.Converters"
    mc:Ignorable="d">
    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>
    <Grid Padding="32" RowDefinitions="Auto,*" Width="360">
        <TextBlock Text="Unlock" FontSize="22" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" Spacing="12">
            <TextBlock Text="Enter your password to unlock local data." Foreground="Gray" TextWrapping="Wrap" />
            <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" PlaceholderText="Password" />
            <PasswordBox
                x:Name="ConfirmBox"
                PasswordChanged="OnConfirmPasswordChanged"
                PlaceholderText="Confirm password"
                Visibility="{x:Bind ViewModel.IsFirstRun, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Content="Unlock"
                    Command="{x:Bind ViewModel.UnlockCommand}"
                    IsEnabled="{x:Bind ViewModel.IsUnlockEnabled, Mode=OneWay}" />
                <Button Content="Set Password" Command="{x:Bind ViewModel.SetPasswordCommand}" Visibility="{x:Bind ViewModel.IsFirstRun, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="Tomato" />
        </StackPanel>
    </Grid>
</Page>
